{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2020-14343",
              "shortDescription": {
                "text": "CVE-2020-14343: PyYAML arbitrary code execution via full_load"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "security-severity": "9.8",
                "tags": ["security", "vulnerability"]
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2020-14343",
          "level": "error",
          "message": {
            "text": "Package: pyyaml\nInstalled Version: 5.3.1\nFixed Version: 5.4.0"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt"
                },
                "region": {
                  "startLine": 1,
                  "startColumn": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
